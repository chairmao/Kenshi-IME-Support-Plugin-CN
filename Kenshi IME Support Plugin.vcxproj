  <!-- KenshiLib + boost locations.
       Preference order:
         1) the copy shipped inside this repo   (KenshiMods.Deps.props)
         2) one level up, for a multi-mod workspace sharing a single sheet
         3) nothing - the project still configures; then either add a sheet via
            View -> Property Manager, or pass /p:KenshiLibDir=... /p:BoostDir=...
       Both imports are conditional so a fresh clone never hard-fails just because
       the dependency sheet lives somewhere else. -->
  <Import Project="$(MSBuildThisFileDirectory)KenshiMods.Deps.props"
          Condition="Exists('$(MSBuildThisFileDirectory)KenshiMods.Deps.props')" />
  <Import Project="$(MSBuildThisFileDirectory)..\KenshiMods.Deps.props"
          Condition="!Exists('$(MSBuildThisFileDirectory)KenshiMods.Deps.props') And Exists('$(MSBuildThisFileDirectory)..\KenshiMods.Deps.props')" />
